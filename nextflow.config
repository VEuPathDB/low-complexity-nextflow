profiles {
  aa {
    params {
      inputFilePath = "$baseDir/data/input-aa.fa"
      fastaSubsetSize = 500
      outputFileName = "lowComplexity-aa.bed"
      outputDir = "$launchDir/output"
      seqType = "aa"
      index = true
    }
    process {
      maxForks = 4
    }
    docker {
      enabled = true
    }    
  }
  na {
    params {
      inputFilePath = "$baseDir/data/input-na.fa"
      fastaSubsetSize = 1
      outputFileName = "lowComplexity-na.bed"
      outputDir = "$launchDir/output"
      seqType = "na"
      index = true
    }
    process {
      maxForks = 4
    }
    docker {
      enabled = true
    }
  }
}